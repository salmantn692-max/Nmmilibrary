rules_version = '2';

// Only signed-in staff (created in Firebase Console → Authentication → Users)
// can read or write anything in this database. There is no public, unauthenticated
// access — this is the real security boundary, not the sign-in screen in the app.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
